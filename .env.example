# --- Groq API ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Any current Groq chat model works, e.g. llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# --- Server ---
# Random long string used to sign session cookies. Change this to your own random value.
SESSION_SECRET=change-this-to-a-random-secret-string
PORT=5000

# --- Login ---
# Only used the very first time the server runs (to seed data/auth.json).
# After that, change the password from the "Password bhool gaye?" link on
# the login page — data/auth.json becomes the source of truth.
AUTH_USERNAME=merigilehari
AUTH_PASSWORD=NehhuAkku22

# --- Password reset / login OTP email ---
# Sends a 4-digit OTP (valid 2 minutes) from EMAIL_USER to RESET_OTP_EMAIL for
# both password resets and every login.
# EMAIL_APP_PASSWORD must be a Gmail App Password, not your normal Gmail password:
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an app password: https://myaccount.google.com/apppasswords
# If EMAIL_APP_PASSWORD is left blank, OTPs are printed to the server console
# instead of emailed (handy for local testing).
EMAIL_USER=akashgupta231001@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password_here
RESET_OTP_EMAIL=nehaljain0909@gmail.com

# --- Personalization ---
# These control every name/label shown on the site.
SITE_TITLE=For My Nehuuu
SITE_TAGLINE=Just a girl who makes my world brighter
PARTNER_FULL_NAME=Nehal Jain
PARTNER_NICKNAME=Gilehriii
YOUR_NAME=Akash

# Optional photos. Drop image files into public/img/ and point these at
# them, e.g. PARTNER_PHOTO=/img/nehal.jpg — leave blank to keep the default
# letter avatar / pink gradient.
PARTNER_PHOTO=
HERO_PHOTO=
